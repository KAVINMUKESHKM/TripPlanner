DATABASE_URL=postgres://postgres:postgres@localhost:5432/tripplanner?sslmode=disable
# Optional separate schema owner used only by `go run ./cmd/migrate up`.
MIGRATOR_DATABASE_URL=
IMPORTER_DATABASE_URL=
PORT=8080
FRONTEND_URL=http://localhost:3000
OPENWEATHER_API_KEY=
OPENCAGE_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass.private.coffee/api/interpreter
COOKIE_SECURE=false
APP_ENV=development
TRUSTED_PROXIES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
# Resend SMTP (or another STARTTLS-compatible SMTP provider)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# Resend uses the literal username "resend" and your API key as the password.
SMTP_USERNAME=resend
SMTP_PASSWORD=
# Use onboarding@resend.dev for Resend testing, or an address on your verified domain.
SMTP_FROM=onboarding@resend.dev
